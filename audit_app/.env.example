# Independent audit deployment only. Never copy the main Adswise database or secrets.
AUDIT_PUBLIC_ORIGIN=http://localhost:8001
AUDIT_DATABASE_URL=
AUDIT_DB_PATH=data/audit.db
AUDIT_COOKIE_SECURE=false
# Required for signup. Generate a new random invitation code and share privately with pilot users.
AUDIT_SIGNUP_CODE=
AUDIT_GOOGLE_CLIENT_ID=
AUDIT_GOOGLE_CLIENT_SECRET=
AUDIT_GOOGLE_DEVELOPER_TOKEN=
# Generate a unique Fernet key for this app. Do not reuse the main app key.
AUDIT_TOKEN_ENCRYPTION_KEY=
AUDIT_GOOGLE_API_VERSION=v26
