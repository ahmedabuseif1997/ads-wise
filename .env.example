# Required on FIRST BOOT ONLY. No real credentials are bundled.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_OF_AT_LEAST_14_CHARACTERS
INITIAL_SPA_NAME=My Spa
SUPER_ADMIN_EMAILS=owner@example.com
REGISTRATION_INBOX=info@ads-wise.com
RESEND_API_KEY=
TRANSACTIONAL_FROM_EMAIL=Adwise <onboarding@yourdomain.com>

# Production: after HTTPS is configured, use true.
COOKIE_SECURE=true
PUBLIC_ORIGIN=https://ads.example.com
ALLOWED_ORIGINS=https://spa-ads-agent.vercel.app,https://ads-wise.com,https://www.ads-wise.com
ADS_DOMAIN=ads.example.com
DB_PATH=/app/data/adsagent.db

# Optional real AI planner (BytePlus ModelArk or compatible chat/completions API)
# If unset, UI CLEARLY shows deterministic TEMPLATE mode, not AI.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Preferred AI provider. Server-side only; never expose this key in browser code.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3
GITHUB_REPOSITORY=ahmedabuseif1997/ads-wise
# Generate a long random token. Codex/Claude use it only to read and update approved development tasks.
MCP_AGENT_TOKEN=
CODEX_AGENT_ENDPOINT=
CLAUDE_AGENT_ENDPOINT=

# Google Ads OAuth and API access
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_AUTO_SYNC_TTL_SECONDS=300

# Google Business Profile + Search Console OAuth (approved Google Cloud project)
GOOGLE_GROWTH_CLIENT_ID=
GOOGLE_GROWTH_CLIENT_SECRET=

# Meta Marketing API OAuth
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v26.0

# TikTok Marketing API advertiser authorization
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_AUTHORIZATION_URL=
TIKTOK_API_VERSION=v2.0
